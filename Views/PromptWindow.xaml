<Window x:Class="GameServerKeeper.Views.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:GameServerKeeper.Views"
        xmlns:vm="clr-namespace:GameServerKeeper.ViewModels"
        Title="{Binding Title}" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="White"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display">
    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold"/>
        <TextBlock Text="{Binding Caption}" Style="{StaticResource Muted}" Margin="1,8,0,14" TextWrapping="Wrap" LineHeight="19"/>
        <TextBox x:Name="Input" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{Binding OkText}" Style="{StaticResource PrimaryButton}" IsDefault="True" MinWidth="88"
                    v:ButtonAssist.Glyph="{x:Static vm:Glyphs.Announce}" Command="{Binding OkCommand}"/>
            <Button Content="취소" Margin="8,0,0,0" IsCancel="True" MinWidth="80" Command="{Binding CancelCommand}"/>
        </StackPanel>
    </StackPanel>
</Window>
