<Window x:Class="GameServerKeeper.Views.AddServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:GameServerKeeper.Views"
        xmlns:vm="clr-namespace:GameServerKeeper.ViewModels"
        Title="서버 추가" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="White"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display">
    <StackPanel Margin="28,24,28,24">
        <TextBlock Text="서버 추가" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="서버 실행 파일을 고르면 어떤 게임인지 자동으로 알아내요." Style="{StaticResource Muted}" Margin="1,6,0,22"/>

        <TextBlock Text="서버 실행 파일" FontWeight="Bold" Margin="0,0,0,8"/>
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="찾아보기" Margin="8,0,0,0" Style="{StaticResource CompactButton}" Padding="12,7"
                    v:ButtonAssist.Glyph="{x:Static vm:Glyphs.Folder}" Command="{Binding BrowseCommand}"/>
            <TextBox x:Name="ExeBox" Text="{Binding ExePath, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="서버를 실행하는 exe 또는 bat 파일이에요. 예: D:\Steam_Dedicated_Server\Palworld\PalServer.exe"/>
        </DockPanel>

        <!-- 인식 결과 -->
        <Border Margin="0,14,0,0" CornerRadius="10" Padding="16,14" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDetected}" Value="True">
                            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                            <Setter Property="BorderBrush" Value="#C7CBF5"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Grid Width="38" Height="38" VerticalAlignment="Top">
                    <Ellipse Fill="White"/>
                    <TextBlock Style="{StaticResource Icon}" Text="{Binding DetectGlyph}" FontSize="17"
                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                </Grid>
                <StackPanel Margin="14,0,0,0">
                    <TextBlock Text="{Binding DetectTitle}" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="{Binding DetectDescription}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"
                               TextWrapping="Wrap" LineHeight="18"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock Text="서버 이름" FontWeight="Bold" Margin="0,22,0,8"/>
        <TextBox Text="{Binding ServerName, UpdateSourceTrigger=PropertyChanged}" ToolTip="사이드바와 디스코드 알림에 표시되는 이름이에요."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
            <Button Content="다음" Style="{StaticResource PrimaryButton}" IsDefault="True" MinWidth="88"
                    v:ButtonAssist.Glyph="{x:Static vm:Glyphs.Play}" Command="{Binding NextCommand}"
                    ToolTip="다음 화면에서 폴더·업데이트·백업 같은 세부 설정을 확인하고 저장해요."/>
            <Button Content="취소" Margin="8,0,0,0" IsCancel="True" MinWidth="80" Command="{Binding CancelCommand}"/>
        </StackPanel>
    </StackPanel>
</Window>
