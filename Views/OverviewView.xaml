<UserControl x:Class="GameServerKeeper.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:GameServerKeeper.Views"
             xmlns:c="clr-namespace:GameServerKeeper.Views.Controls"
             xmlns:vm="clr-namespace:GameServerKeeper.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition MinHeight="160"/>
        </Grid.RowDefinitions>

        <!-- 머리글 -->
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="전체 현황" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" Margin="2,6,0,0"/>
        </StackPanel>

        <!-- 요약 타일 -->
        <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,0,-12,14">
            <c:StatTile Title="실행 중인 서버" Glyph="{x:Static vm:Glyphs.Server}" Accent="{StaticResource SuccessBrush}"
                        Info="{Binding RunningStat}" Margin="0,0,12,0"/>
            <c:StatTile Title="전체 접속자" Glyph="{x:Static vm:Glyphs.People}" Accent="{StaticResource InfoBrush}"
                        Info="{Binding PlayersStat}" Margin="0,0,12,0" ToolTip="접속자 조회를 지원하는 서버들의 접속자 합계예요."/>
            <c:StatTile Title="메모리 합계" Glyph="{x:Static vm:Glyphs.Memory}" Accent="{StaticResource PurpleBrush}"
                        Info="{Binding MemoryStat}" Margin="0,0,12,0" ToolTip="실행 중인 모든 서버 프로세스의 메모리 사용량 합계예요."/>
            <c:StatTile Title="다음 정기 재시작" Glyph="{x:Static vm:Glyphs.Calendar}" Accent="{StaticResource WarningBrush}"
                        Info="{Binding NextRestartStat}" Margin="0,0,12,0"/>
        </UniformGrid>

        <!-- 서버 카드 -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Cards}" Focusable="False" Margin="0,0,-14,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.Resources>
                <!-- 서버 카드 -->
                <DataTemplate DataType="{x:Type vm:ServerViewModel}">
                    <Border Width="330" Height="190" Margin="0,0,14,14" Padding="18,16" Cursor="Hand"
                            ToolTip="눌러서 서버 화면 열기">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                <Setter Property="Padding" Value="18,16"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="#C7CBF5"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding OpenCommand}"/>
                        </Border.InputBindings>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                                <Button Style="{StaticResource SuccessButton}" Padding="12,6" Content="시작"
                                        v:ButtonAssist.Glyph="{x:Static vm:Glyphs.Play}" Command="{Binding StartCommand}"
                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}, ConverterParameter=invert}"/>
                                <Button Style="{StaticResource DangerButton}" Padding="12,6" Content="안전 종료"
                                        v:ButtonAssist.Glyph="{x:Static vm:Glyphs.Stop}" Command="{Binding StopCommand}"
                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}"/>
                                <Button Padding="12,6" Margin="8,0,0,0" Content="열기"
                                        v:ButtonAssist.Glyph="{x:Static vm:Glyphs.View}" Command="{Binding OpenCommand}"/>
                            </StackPanel>
                            <StackPanel>
                                <DockPanel>
                                    <c:StatusPill DockPanel.Dock="Right" Text="{Binding StateText}" Tone="{Binding StateTone}" Margin="8,0,0,0"/>
                                    <TextBlock Text="{Binding Name}" FontSize="16.5" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Style="{StaticResource Icon}" Text="{x:Static vm:Glyphs.Game}" FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding GameName}" Style="{StaticResource Muted}" FontSize="12" Margin="6,0,0,0"/>
                                </StackPanel>
                                <DockPanel Margin="0,14,0,0">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding MemoryText}" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock Text="메모리" Style="{StaticResource Muted}" FontSize="12"/>
                                </DockPanel>
                                <ProgressBar Style="{StaticResource SlimBar}" Margin="0,6,0,0"
                                             Value="{Binding MemoryRatio, Converter={StaticResource RatioPercent}}"
                                             Foreground="{Binding MemoryTone, Converter={StaticResource ToneBrush}}"/>
                                <TextBlock Text="{Binding CardSummary}" Style="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>

                <!-- 서버 추가 카드 -->
                <DataTemplate DataType="{x:Type vm:AddCardItem}">
                    <Button Width="330" Height="190" Margin="0,0,14,14" Command="{Binding Command}" Cursor="Hand"
                            ToolTip="새 데디 서버를 등록해요. 실행 파일을 고르면 게임을 자동으로 알아내요.">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Background="Transparent">
                                    <Rectangle x:Name="Frame" RadiusX="12" RadiusY="12" Stroke="#C4C9D2" StrokeThickness="1.5"
                                               StrokeDashArray="4 3" Fill="Transparent"/>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid Width="44" Height="44">
                                            <Ellipse Fill="{StaticResource AccentSoftBrush}"/>
                                            <TextBlock Style="{StaticResource Icon}" Text="{x:Static vm:Glyphs.Add}" FontSize="18"
                                                       Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Text="서버 추가" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0"
                                                   HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}"/>
                                    </StackPanel>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Frame" Property="Fill" Value="#F7F7FF"/>
                                        <Setter TargetName="Frame" Property="Stroke" Value="{StaticResource AccentLightBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DataTemplate>
            </ItemsControl.Resources>
        </ItemsControl>

        <!-- 전체 로그 -->
        <Border Grid.Row="3" Style="{StaticResource DarkCard}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource Icon}" Text="{x:Static vm:Glyphs.Document}" FontSize="14"
                               Foreground="{StaticResource LogTextBrush}"/>
                    <TextBlock Text="전체 로그" Style="{StaticResource CardTitle}" Margin="8,0,0,0" Foreground="{StaticResource LogTextBrush}"/>
                </StackPanel>
                <c:LogView DataContext="{Binding Log}"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
