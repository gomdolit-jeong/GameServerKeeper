<UserControl x:Class="GameServerKeeper.Views.Controls.StatTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Style="{StaticResource Card}" Padding="16,14">
        <StackPanel>
            <DockPanel>
                <Grid Width="28" Height="28" DockPanel.Dock="Left">
                    <Border CornerRadius="8" Background="{Binding Accent, ElementName=Root}" Opacity="0.13"/>
                    <TextBlock Style="{StaticResource Icon}" FontSize="14" HorizontalAlignment="Center"
                               Text="{Binding Glyph, ElementName=Root}" Foreground="{Binding Accent, ElementName=Root}"/>
                </Grid>
                <TextBlock Text="{Binding Title, ElementName=Root}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12.5"
                           Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <TextBlock x:Name="ValueText" Margin="0,10,0,0" FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                       Text="{Binding Info.Value, ElementName=Root}"
                       Foreground="{Binding Info.Tone, ElementName=Root, Converter={StaticResource ToneBrush}}"/>
            <TextBlock Margin="0,3,0,0" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"
                       Text="{Binding Info.Caption, ElementName=Root}"/>
            <ProgressBar Style="{StaticResource SlimBar}" Margin="0,10,0,0"
                         Value="{Binding Info.Progress, ElementName=Root, Converter={StaticResource RatioPercent}}"
                         Foreground="{Binding Info.ProgressTone, ElementName=Root, Converter={StaticResource ToneBrush}}"
                         Visibility="{Binding Info.Progress, ElementName=Root, Converter={StaticResource NullVis}}"/>
        </StackPanel>
    </Border>
</UserControl>
