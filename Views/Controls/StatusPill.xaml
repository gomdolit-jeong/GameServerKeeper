<UserControl x:Class="GameServerKeeper.Views.Controls.StatusPill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" VerticalAlignment="Center">
    <Border CornerRadius="12" Padding="10,4,12,4" Background="{Binding Tone, ElementName=Root, Converter={StaticResource ToneSoftBrush}}">
        <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                     Fill="{Binding Tone, ElementName=Root, Converter={StaticResource ToneBrush}}"/>
            <TextBlock Margin="6,0,0,0" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"
                       Text="{Binding Text, ElementName=Root}"
                       Foreground="{Binding Tone, ElementName=Root, Converter={StaticResource ToneBrush}}"/>
        </StackPanel>
    </Border>
</UserControl>
